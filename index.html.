
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Bongo Bitlfie Simulator</title>
<style>
:root {
  --bg: #10121b;
  --card: #1b1f2d;
  --text: #f5f6ff;
  --muted: #9da5bb;
  --green: #39e58c;
  --blue: #6577ff;
}
* { box-sizing: border-box; }
body {
  margin: 0;
  background: var(--bg);
  color: var(--text);
  font-family: system-ui, sans-serif;
}
header {
  padding: 22px 18px;
  background: linear-gradient(135deg,#252b49,#161a28);
  border-bottom: 1px solid #30364b;
}
.brand { font-size: 23px; font-weight: 900; }
.brand span { color: var(--green); }
header p { color: var(--muted); margin: 6px 0 0; }
main { max-width: 650px; margin: auto; padding: 16px; }
.card {
  background: var(--card);
  border: 1px solid #30364a;
  border-radius: 18px;
  padding: 18px;
  margin-bottom: 15px;
}
.profile {
  display: flex;
  align-items: center;
  gap: 15px;
}
.avatar {
  width: 76px;
  height: 76px;
  border-radius: 20px;
  display: grid;
  place-items: center;
  font-size: 42px;
  background: linear-gradient(135deg,#454e85,#242b49);
}
h2,h3,p { margin-top: 0; }
h2 { margin-bottom: 5px; font-size: 21px; }
.muted { color: var(--muted); font-size: 13px; }
.stats {
  display: grid;
  grid-template-columns: repeat(2,1fr);
  gap: 10px;
}
.stat {
  background: #131622;
  border-radius: 12px;
  padding: 13px;
}
.stat-label { color: var(--muted); font-size: 12px; }
.stat-value { font-size: 21px; font-weight: 800; margin-top: 5px; }
.green { color: var(--green); }
h3 { margin-bottom: 14px; }
button {
  border: 0;
  border-radius: 12px;
  padding: 13px 12px;
  background: #30374e;
  color: white;
  font-size: 14px;
  font-weight: 700;
  cursor: pointer;
}
button:active { transform: scale(.98); }
.primary { background: var(--green); color: #101820; }
.actions {
  display: grid;
  grid-template-columns: repeat(2,minmax(0,1fr));
  gap: 9px;
}
.action-icon { font-size: 20px; display: block; margin-bottom: 6px; }
.wide { width: 100%; margin-top: 12px; }
#log { line-height: 1.6; font-size: 14px; }
.log-entry {
  padding: 9px 0;
  border-bottom: 1px solid #30364a;
}
footer { text-align: center; padding: 20px; color: var(--muted); font-size: 12px; }
</style>
</head>
<body>
<header>
  <div class="brand">🇹🇿 BONGO <span>BITLFIE</span></div>
  <p>Your life. Your choices. Your future.</p>
</header>

<main>
  <section class="card">
    <div class="profile">
      <div class="avatar">🧑🏾</div>
      <div>
        <h2 id="name">New Citizen</h2>
        <div class="muted" id="bio">Age 18 · Tanzania</div>
        <div class="muted" id="status">🎓 Ready to start your journey</div>
      </div>
    </div>
  </section>

  <section class="card">
    <h3>📊 Life Overview</h3>
    <div class="stats">
      <div class="stat">
        <div class="stat-label">🎂 Age</div>
        <div class="stat-value" id="age">18</div>
      </div>
      <div class="stat">
        <div class="stat-label">💰 Money</div>
        <div class="stat-value green" id="money">TSh 500,000</div>
      </div>
      <div class="stat">
        <div class="stat-label">❤️ Health</div>
        <div class="stat-value" id="health">100%</div>
      </div>
      <div class="stat">
        <div class="stat-label">😊 Happiness</div>
        <div class="stat-value" id="happy">80%</div>
      </div>
    </div>
  </section>

  <section class="card">
    <h3>🎯 Make Your Choices</h3>
    <div class="actions">
      <button onclick="study()"><span class="action-icon">📚</span>Study</button>
      <button onclick="work()"><span class="action-icon">💼</span>Find Work</button>
      <button onclick="business()"><span class="action-icon">🏪</span>Start Business</button>
      <button onclick="exercise()"><span class="action-icon">🏃🏾</span>Exercise</button>
      <button onclick="socialize()"><span class="action-icon">❤️</span>Social Life</button>
      <button onclick="rest()"><span class="action-icon">🛌</span>Rest</button>
    </div>
    <button class="primary wide" onclick="ageUp()">🎂 AGE UP — Next Year</button>
  </section>

  <section class="card">
    <h3>📖 Your Life Story</h3>
    <div id="log" aria-live="polite">
      <div class="log-entry">✨ Your story begins in Tanzania. What will you do with your life?</div>
    </div>
  </section>
</main>

<footer>Bongo Bitlfie Simulator · Version 1.0</footer>

<script>
let player = {
  age: 18,
  money: 500000,
  health: 100,
  happiness: 80,
  education: 0,
  employed: false,
  business: false
};

function formatMoney(amount) {
  return "TSh " + Math.floor(amount).toLocaleString("en-US");
}

function update() {
  document.getElementById("age").textContent = player.age;
  document.getElementById("money").textContent = formatMoney(player.money);
  document.getElementById("health").textContent = player.health + "%";
  document.getElementById("happy").textContent = player.happiness + "%";
  document.getElementById("bio").textContent =
    "Age " + player.age + " · Tanzania";

  let status = player.business ? "🏪 Business Owner" :
    player.employed ? "💼 Employed" :
    player.education > 0 ? "📚 Student" : "🌱 Building your future";

  document.getElementById("status").textContent = status;
}

function log(message) {
  const entry = document.createElement("div");
  entry.className = "log-entry";
  entry.textContent = message;
  const box = document.getElementById("log");
  box.prepend(entry);
}

function study() {
  if (player.money < 50000) {
    log("📚 You need TSh 50,000 to pay for study materials.");
    return;
  }
  player.money -= 50000;
  player.education++;
  player.happiness = Math.min(100, player.happiness + 5);
  log("📚 You studied hard and improved your knowledge!");
  update();
}

function work() {
  if (player.employed) {
    log("💼 You already have a job. Keep building your career!");
    return;
  }
  if (player.age < 18) {
    log("💼 You need to be at least 18 to apply for this job.");
    return;
  }
  player.employed = true;
  player.money += 300000;
  log("💼 Congratulations! You found a job and earned TSh 300,000.");
  update();
}

function business() {
  if (player.business) {
    log("🏪 Your business is running. Keep growing it!");
    return;
  }
  if (player.money < 250000) {
    log("🏪 You need TSh 250,000 to start a small business.");
    return;
  }
  player.money -= 250000;
  player.business = true;
  log("🏪 You opened a small business in Tanzania!");
  update();
}

function exercise() {
  player.health = Math.min(100, player.health + 10);
  player.happiness = Math.min(100, player.happiness + 3);
  log("🏃🏾 You exercised and took care of your health.");
  update();
}

function socialize() {
  player.happiness = Math.min(100, player.happiness + 10);
  player.money -= 10000;
  log("❤️ You spent time with friends. Happiness increased!");
  update();
}

function rest() {
  player.health = Math.min(100, player.health + 5);
  player.happiness = Math.min(100, player.happiness + 5);
  log("🛌 You rested and felt refreshed.");
  update();
}

function ageUp() {
  player.age++;
  player.health = Math.max(0, player.health - 1);
  player.money -= 50000;

  if (player.employed) player.money += 300000;
  if (player.business) player.money += 100000;

  if (player.money < 0) player.money = 0;

  log("🎂 You turned " + player.age +
    "! A new year brings new opportunities and challenges.");

  if (player.age === 25) {
    log("🌟 You are 25! Think about your career, relationships and future.");
  }

  if (player.age >= 100) {
    log("🎉 You have reached 100 years old. What a life story!");
  }

  update();
}

update();
</script>
</body>
</html>
